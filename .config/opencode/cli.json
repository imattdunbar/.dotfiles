{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "session.delete": "alt+d",
    "input.delete": "alt+d,delete,shift+delete",
    "input.delete.word.forward": "alt+delete,ctrl+delete",
    "session.background": "<leader>b",
    "session.sidebar.toggle": "<leader>p",
    "session.tab.select.1": "<leader>1",
    "session.tab.select.2": "<leader>2"
  },
  "theme": {
    "name": "dunbar"
  },
  "tabs": {
    "mode": "off"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
