{
  "default_agent": "plan",
  "model": "openai/gpt-6.1-sol",
  "agents": {
    "plan": {
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "build": {
      "mode": "primary"
    },
    "general": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna"
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna"
    },
    "title": {
      "model": "openai/gpt-6-luna"
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "**/*.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env*", "effect": "deny" }
  ],
  "plugins": [
    {
      "package": "{env:HOME}/.config/scripts/oc-dunbar"
    }
  ],
  "mcp": {
    "servers": {
      "playwriter": {
        "type": "local",
        "command": ["playwriter"] // https://github.com/remorses/playwriter
      }
    }
  }
}
