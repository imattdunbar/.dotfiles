{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  /*
    OpenAI Plan
    "model": "openai/gpt-5.5-fast",
    CoPilot Plan
    "model": "github-copilot/gpt-5.3-codex",
    Vertex
    "model": "google-vertex-anthropic/claude-opus-4-6@default",
  */
  // "model": "openai/gpt-5.6-sol-fast",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna-fast",
  "agent": {
    "plan": {
      "mode": "primary",
      // "model": "openai/gpt-5.6-sol-fast",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "build": {
      "mode": "primary",
      // "model": "openai/gpt-5.6-sol-fast",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "general": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra-fast"
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra-fast"
    }
  },
  "permission": {
    "external_directory": {
      "~/Desktop/**": "allow",
      "~/.bun/**": "allow",
      "~/.config/opencode/opencode.jsonc": "allow",
      "**/*.env": "deny",
      "**/.env*": "deny"
    }
  },
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "manual"
      }
    ],
    "{env:HOME}/.config/scripts/oc-agy-proxy.ts",
    "opencode-with-claude"
  ],
  "mcp": {
    "playwriter": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "playwriter@latest"] // https://github.com/remorses/playwriter
    }
  },
  "provider": {
    // Disabled opencode + openrouter models for now - plans are too good of a deal.
    // Provider + Model ID search: https://models.dev
    "antigravity": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Antigravity CLI",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "timeout": false,
        "chunkTimeout": 30000
      },
      "models": {
        "gemini-3.7-flash-high": {
          "name": "Gemini 3.7 Flash",
          "reasoning": true,
          "tool_call": false,
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    },
    "anthropic": {
      "whitelist": [
        "claude-opus-5", // expensive yapper
        "claude-opus-4-8"
      ],
      "models": {
        "claude-opus-5": {
          "options": {
            "effort": "medium"
          }
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    },
    "opencode": {
      "whitelist": [
        // "kimi-k3",
        // "deepseek-v4-pro",
        // "deepseek-v4-flash",
        // "grok-4.6",
      ]
    },
    "opencode-go": {
      "whitelist": ["glm-5.3-flash", "deepseek-v4-flash", "kimi-k3"]
    },
    "openrouter": {
      "whitelist": [
        // "google/gemini-3.7-flash"
        // "anthropic/claude-opus-4.6"
        // "openai/gpt-5.4-nano"
      ]
    },
    "openai": {
      "whitelist": [
        // "gpt-5.5-fast",
        "gpt-5.6-sol",
        "gpt-5.6-sol-1m",
        "gpt-5.6-sol-fast", // flagship
        "gpt-5.6-terra-fast", // mini
        "gpt-5.6-luna-fast", // nano
        "gpt-5.3-codex-spark"
      ],
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-sol-1m": {
          "id": "gpt-5.6-sol",
          "name": "GPT-5.6 Sol 1M",
          "limit": {
            "context": 1000000,
            "input": 922000,
            "output": 128000
          },
          "options": {
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-sol-fast": {
          "options": {
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-terra-fast": {
          "options": {
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-luna-fast": {
          "options": {
            "textVerbosity": "low"
          }
        }
      }
    },
    "github-copilot": {
      "whitelist": [
        // "gemini-3-flash-preview",
        // "gemini-3.1-pro-preview",
        // "gpt-5.3-codex"
        // "claude-sonnet-4.6",
        // "claude-opus-4.6"
      ]
    },
    "cloudflare-workers-ai": {
      "whitelist": [
        // "@cf/moonshotai/kimi-k2.5"
      ]
    },
    "github-copilot-enterprise": {
      "whitelist": []
    },
    "github-models": {
      "whitelist": []
    },
    // ----- Work ------
    "google-vertex": {
      "whitelist": [
        // "gemini-3.1-pro-preview"
      ]
    },
    "google-vertex-anthropic": {
      "whitelist": [
        // "claude-sonnet-4-6@default",
        // "claude-opus-4-6@default"
      ]
    }
    // -----------------
  }
}
