{
  "default_agent": "plan",
  "model": "openai/gpt-6.1-sol",
  "agents": {
    "plan": {
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "build": {
      "mode": "primary"
    },
    "general": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra#low"
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra#low"
    },
    "compaction": {
      "model": "openai/gpt-6-luna#medium"
    },
    "summary": {
      "model": "openai/gpt-6-luna#low"
    },
    "title": {
      "model": "openai/gpt-6-luna#none"
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "**/*.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env*", "effect": "deny" }
  ],
  "plugins": [
    {
      "package": "{env:HOME}/.config/scripts/oc-dunbar"
    }
  ],
  "mcp": {
    "servers": {
      "playwriter": {
        "type": "local",
        "command": ["playwriter"]
        // https://github.com/remorses/playwriter
      },
      "dbhub": {
        "type": "local",
        "disabled": true,
        "command": ["dbhub", "--transport", "stdio", "--config", "{env:HOME}/.config/opencode/dbhub.toml"]
        // https://github.com/bytebase/dbhub
      },
      "figma": {
        "type": "remote",
        "disabled": true,
        "url": "https://mcp.figma.com/mcp"
      },
      "paper": {
        "type": "local",
        "disabled": true,
        "command": ["{env:HOME}/.paper/bin/paper", "mcp"]
      },
      "doop": {
        "type": "remote",
        "disabled": true,
        "url": "https://doop.design/mcp"
      }
    }
  }
}
