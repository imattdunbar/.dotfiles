{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  // "model": "openai/gpt-5.6-sol-fast",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna-fast",
  "agent": {
    "plan": {
      "mode": "primary",
      // "model": "openai/gpt-5.6-sol-fast",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "build": {
      "mode": "primary",
      // "model": "openai/gpt-5.6-sol-fast",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "general": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra-fast"
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra-fast"
    }
  },
  "permission": {
    "external_directory": {
      "~/Desktop/**": "allow",
      "~/.bun/**": "allow",
      "~/.config/opencode/opencode.jsonc": "allow",
      "**/*.env": "deny",
      "**/.env*": "deny"
    }
  },
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "manual"
      }
    ],
    "{env:HOME}/.config/scripts/oc-session-dashboard.ts",
    "opencode-with-claude"
  ],
  "mcp": {
    "playwriter": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "playwriter@latest"] // https://github.com/remorses/playwriter
    }
  },
  "provider": {
    // Provider + Model ID search: https://models.dev
    "anthropic": {
      "whitelist": [
        // "claude-opus-5", // expensive yapper
        "claude-opus-4-8"
      ],
      "models": {
        "claude-opus-5": {
          "options": {
            "effort": "medium"
          }
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    },
    "opencode": {
      "whitelist": [
        // no opencode zen models
        // "muse-spark-1.3-contributor-free"
      ]
    },
    "opencode-go": {
      "whitelist": [
        // opencode go sub
        "muse-spark-1.3-contributor",
        "glm-5.3-flash",
        // "deepseek-v4-flash",
        "kimi-k3"
      ]
    },
    "openrouter": {
      "whitelist": [
        // no openrouter models
      ]
    },
    "openai": {
      "whitelist": [
        "gpt-5.6-sol",
        "gpt-5.6-sol-1m",
        "gpt-5.6-sol-fast", // flagship
        "gpt-5.6-terra-fast", // mini
        "gpt-5.6-luna-fast" // nano
      ],
      "models": {
        "gpt-5.6-sol-1m": {
          "id": "gpt-5.6-sol",
          "name": "GPT-5.6 Sol 1M",
          "limit": {
            "context": 1000000,
            "input": 922000,
            "output": 128000
          },
          "options": {
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-sol": {
          "options": {
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-sol-fast": {
          "options": {
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-terra-fast": {
          "options": {
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-luna-fast": {
          "options": {
            "textVerbosity": "low"
          }
        }
      }
    },
    "github-copilot": {
      "whitelist": ["claude-opus-5"]
    },
    "cloudflare-workers-ai": {
      "whitelist": []
    },
    "github-copilot-enterprise": {
      "whitelist": []
    },
    "github-models": {
      "whitelist": []
    },
    // ----- Work ------
    "google-vertex": {
      "whitelist": [
        // "gemini-3.1-pro-preview"
      ]
    },
    "google-vertex-anthropic": {
      "whitelist": [
        // "claude-sonnet-4-6@default",
        // "claude-opus-4-6@default"
      ]
    }
    // -----------------
  }
}
