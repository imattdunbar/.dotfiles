// Copy this file to the working directory of whatever project to utilize the mcp servers
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "dbhub": {
        "type": "local",
        "disabled": false,
        "command": ["dbhub", "--transport", "stdio", "--config", "{env:HOME}/.config/opencode/dbhub.toml"]
      },
      "figma": {
        "type": "remote",
        "disabled": false,
        "url": "https://mcp.figma.com/mcp"
      },
      "paper": {
        "type": "local",
        "disabled": false,
        "command": ["{env:HOME}/.paper/bin/paper", "mcp"]
      }
    }
  }
}
