# Docs = https://ghostty.org/docs/config/reference
# Good example for reference = https://github.com/exosyphon/dotfiles/blob/main/ghostty.conf

# Font
font-family = "FiraCode Nerd Font Mono"
font-thicken = true
font-variation = wght=500
font-size = 14
font-feature = -liga
font-feature = -calt
font-feature = -dlig

# Colors
theme = dunbar
background-opacity = 0.85
background-blur-radius = 5

# Window
macos-titlebar-style = hidden
window-padding-x = 16,0
window-padding-y = 16,0

# Before macOS 27
# macos-titlebar-style = transparent
# window-padding-x = 16,0
# window-padding-y = 0

window-padding-color = extend
# window-height = 48
# window-width = 160
window-save-state = always

# General
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

mouse-hide-while-typing = true
window-new-tab-position = end
window-inherit-working-directory = false
working-directory = home

# Ask before quitting
confirm-close-surface = false

# Quick Terminal
keybind = global:opt+q=toggle_quick_terminal
quick-terminal-animation-duration=0
quick-terminal-position=center

# -- Keybinds --

# Cmd controls Ghostty panes.
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

keybind = cmd+shift+r=reload_config

# Let Herdr receive these keys.
keybind = ctrl+d=unbind
keybind = ctrl+shift+d=unbind

# Make tmux see opt+d and opt+c
keybind = opt+d=text:\x1bd
keybind = opt+c=text:\x1bc

# Open the git branch picker directly.
keybind = cmd+shift+b=text:fsb\r

# CMD + Shift + C => Copy current path
keybind = cmd+shift+c=text:pwd | pbcopy\r

# Ignore CMD+Enter, default takes Ghostty fullscreen
keybind = cmd+enter=ignore
