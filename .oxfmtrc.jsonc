{
  // Personal fallback: applies only where no nearer oxfmt config exists.
  // Project configs always win over this file.
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "semi": false,
  "printWidth": 120,
  "sortTailwindcss": true,
  "sortPackageJson": false,
  // Generated files are never worth formatting, anywhere.
  "ignorePatterns": [
    // Tanstack Gen Router
    "**/*.gen.ts",
    // Uniwind Expo
    "**/uniwind-types.d.ts",
    // Drizzle migrations
    "**/migrations/**/*.json",
    // iOS asset catalogs
    "**/Assets.xcassets/**"
  ]
}
